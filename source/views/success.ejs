<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" type="text/css" href="/css/fullds.min.css" />
    <link rel="stylesheet" href="/css/tokens.css" />
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/redesign.css" />
    <link rel="stylesheet" href="/css/notifications.css" />
    <script src="/js/notifications.js" defer></script>
    <!-- <script
      type="text/javascript"
      src="https://unpkg.com/qr-code-styling@1.5.0/lib/qr-code-styling.js"
    ></script> -->

    <title>Success | Child registered successfully</title>
  </head>
  <body class="support-page" onload="replaceDOMElementsWithValues()">
    <main class="staff-card success-card">
      <a class="brand support-brand" href="/" aria-label="Kidz Quest home"><img class="brand-logo" src="/images/logo.png" alt="Kidz Quest" /></a>
      <div class="success-icon" aria-hidden="true">✓</div>
      <span class="eyebrow">ALL SET FOR ADVENTURE</span>
      <h1 class="support-title">You’re on the list<span class="heading-dot">!</span></h1>
      <p class="support-intro">Your little one is registered. Save this code to show us when you pick up your child.</p>
      <div id="code-container">
        <p></p>
        <h2 class="registrant-save-code p-4"></h2>
      </div>
      <p class="security-note">Keep this code private and don’t share it with anyone.</p>
      <button type="button" class="register-button" onclick="handleDone()">I’ve saved the code <span class="button-arrow" aria-hidden="true">↗</span></button>
    </main>

    <script>
      function replaceDOMElementsWithValues() {
        const queryParams = new URLSearchParams(location.search);
        const registrantName = queryParams.get("firstName");
        const registrantId = queryParams.get("id");

        const codeContainer = document.querySelector("#code-container");
        const codeText = codeContainer.querySelector("p");
        const code = codeContainer.querySelector("h2");

        codeText.textContent = "The code for " + registrantName + " is:";
        code.textContent = registrantId;
      }

      async function handleDone() {
        if (await confirmAction("Please make sure you've saved your pickup code before leaving.", { title: "Have you saved the code?", confirmText: "Yes, I’ve saved it" })) {
          location.href = "/";
        }
      }
    </script>
  </body>
</html>
