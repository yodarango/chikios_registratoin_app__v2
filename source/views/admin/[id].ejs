<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/fullds.min.css" />
    <link rel="stylesheet" href="/css/tokens.css" />
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/redesign.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/notifications.css" />
    <script src="/js/notifications.js" defer></script>
    <title>Registrant details | Kidz Quest</title>
    <script src="/js/admin.js" defer></script>
  </head>
  <% const checkedIn = Number(registrant.checked_in) > 0; %>
  <body class="admin-page">
    <header class="admin-header"><div class="admin-header-inner"><a href="/" class="admin-logo" aria-label="Kidz Quest home"><img src="/images/logo.png" alt="Kidz Quest" /></a><div class="admin-header-right"><span class="admin-team-label"><span aria-hidden="true">✦</span> STAFF SPACE</span><a class="admin-home-link" href="/">Registration page <span aria-hidden="true">↗</span></a><form action="/logout" method="post"><button type="submit" class="admin-logout">Log out</button></form></div></div></header>
    <main class="admin-main admin-detail-main">
      <a class="back-link" href="/admin">← <span>Back to registrations</span></a>
      <div class="admin-welcome detail-welcome"><div><span class="admin-eyebrow"><span></span> REGISTRANT DETAILS</span><h1>A little adventurer<span class="admin-coral">.</span></h1><p>Everything you need to know for a smooth pickup.</p></div><span class="welcome-sun" aria-hidden="true">✿</span></div>
      <section class="detail-card" data-registrant-id="<%= registrant.id %>" data-registrant-name="<%= registrant.first_name %> <%= registrant.last_name %>" data-registrant-checked-in="<%= checkedIn %>">
        <div class="detail-profile"><span class="registrant-avatar detail-avatar" aria-hidden="true"><%= (registrant.first_name || '?').charAt(0).toUpperCase() %></span><div><h2><%= registrant.first_name %> <%= registrant.last_name %></h2><p>Pickup code <strong>#<%= registrant.id %></strong></p></div><div class="status-info"><span class="status-pill <%= checkedIn ? 'is-in' : 'is-out' %>" data-status-label><span aria-hidden="true"></span><%= checkedIn ? 'Checked in' : 'Checked out' %></span><small class="status-attribution" data-status-attribution><%= statusAttribution(registrant) %></small></div></div>
        <div class="detail-section"><div class="detail-section-heading"><span class="detail-icon detail-icon-green">01</span><div><h3>Child details</h3><p>A little about your adventurer.</p></div></div><dl class="detail-grid"><div><dt>First name</dt><dd><%= registrant.first_name %></dd></div><div><dt>Last name</dt><dd><%= registrant.last_name %></dd></div><div><dt>Age</dt><dd><%= registrant.age %></dd></div><div><dt>Gender</dt><dd><%= Number(registrant.gender) === 1 ? 'Boy' : Number(registrant.gender) === 2 ? 'Girl' : 'Not specified' %></dd></div></dl></div>
        <div class="detail-section"><div class="detail-section-heading"><span class="detail-icon detail-icon-coral">02</span><div><h3>Guardian details</h3><p>Contact information for their grown-up.</p></div></div><dl class="detail-grid"><div><dt>First name</dt><dd><%= registrant.guardian_first_name || '—' %></dd></div><div><dt>Last name</dt><dd><%= registrant.guardian_last_name || '—' %></dd></div><div class="detail-full"><dt>Phone number</dt><dd><% if (registrant.guardian_phone_number) { %><a href="tel:<%= registrant.guardian_phone_number %>"><%= registrant.guardian_phone_number %> ↗</a><% } else { %>—<% } %></dd></div></dl></div>
        <div class="detail-action-row"><div><strong>Ready to update their status?</strong><p>Keep the roster up to date as children come and go.</p></div><button type="button" class="status-action <%= checkedIn ? 'action-out' : 'action-in' %>" data-status-action aria-label="<%= checkedIn ? 'Check out' : 'Check in' %> <%= registrant.first_name %> <%= registrant.last_name %>"><%= checkedIn ? 'Check out' : 'Check in' %></button></div>
      </section>
      <footer class="admin-footer">MADE WITH <span>♥</span> FOR LITTLE ADVENTURES</footer>
    </main>
  </body>
</html>