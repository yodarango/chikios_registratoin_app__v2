<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/fullds.min.css" />
    <link rel="stylesheet" href="/css/tokens.css" />
    <link rel="stylesheet" href="/css/app.css" />
    <link rel="stylesheet" href="/css/redesign.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/notifications.css" />
    <script src="/js/notifications.js" defer></script>
    <title>Registrations | Kidz Quest</title>
    <script src="/js/admin.js" defer></script>
    <script src="/js/sms-admin.js" defer></script>
  </head>
  <body class="admin-page">
    <header class="admin-header">
      <div class="admin-header-inner">
        <a href="/" class="admin-logo" aria-label="Kidz Quest home"><img src="/images/logo.png" alt="Kidz Quest" /></a>
        <div class="admin-header-right"><span class="admin-team-label"><span aria-hidden="true">✦</span> STAFF SPACE</span><a class="admin-home-link" href="/">Registration page <span aria-hidden="true">↗</span></a></div>
      </div>
    </header>
    <main class="admin-main">
      <div class="admin-welcome">
        <div><span class="admin-eyebrow"><span></span> STAFF DASHBOARD</span><h1>Ready for adventure<span class="admin-coral">.</span></h1><p>Everything you need to keep your little adventurers accounted for.</p></div>
        <span class="welcome-sun" aria-hidden="true">☀</span>
      </div>
      <section class="admin-stats" aria-label="Registration overview">
        <div class="stat-card"><span class="stat-icon stat-yellow" aria-hidden="true">✦</span><div><span class="stat-label">Total registered</span><strong id="total-count"><%= registrants.length %></strong></div></div>
        <div class="stat-card"><span class="stat-icon stat-green" aria-hidden="true">✓</span><div><span class="stat-label">Checked in</span><strong id="in-count"><%= registrants.filter(r => Number(r.checked_in) > 0).length %></strong></div></div>
        <div class="stat-card"><span class="stat-icon stat-coral" aria-hidden="true">↗</span><div><span class="stat-label">Checked out</span><strong id="out-count"><%= registrants.filter(r => !(Number(r.checked_in) > 0)).length %></strong></div></div>
      </section>
      <section class="sms-event-panel" aria-labelledby="sms-event-title"><div><h2 id="sms-event-title">Pickup reminders</h2><p>Schedule an event date in Nashville time. New registrations will join the next enabled event. Reminders run at 8:45 PM and 9:15 PM for children still checked in.</p><p id="sms-mode" role="status">Loading messaging settings…</p></div><form id="sms-event-form"><label for="sms-event-date">Event date</label><div><input id="sms-event-date" type="date" required /><button type="submit">Enable date</button></div></form><div id="sms-event-list" aria-live="polite"></div></section>
      <section class="roster-panel" aria-labelledby="roster-title">
        <div class="roster-heading"><div><span class="admin-eyebrow"><span></span> THE ROSTER</span><h2 id="roster-title">Little adventurers</h2><p>Find a child, view their details, or update their status.</p></div><span class="roster-flower" aria-hidden="true">✿</span></div>
        <div class="roster-controls">
          <div class="search-field"><label for="search">Search registrations</label><div class="search-input-wrap"><span aria-hidden="true">⌕</span><input type="search" id="search" placeholder="Search by name or pickup code" autocomplete="off" /></div></div>
          <div class="filter-group" aria-label="Filter by gender"><span class="filter-label">GENDER</span><div class="filter-buttons"><button type="button" class="filter-button" data-filter-gender="2" aria-pressed="false">Girls</button><button type="button" class="filter-button" data-filter-gender="1" aria-pressed="false">Boys</button></div></div>
          <div class="filter-group" aria-label="Filter by check-in status"><span class="filter-label">STATUS</span><div class="filter-buttons"><button type="button" class="filter-button" data-filter-status="true" aria-pressed="false">Checked in</button><button type="button" class="filter-button" data-filter-status="false" aria-pressed="false">Checked out</button></div></div>
        </div>
        <div class="roster-list-heading"><span>REGISTRATIONS</span><span id="visible-count" aria-live="polite"><%= registrants.length %> shown</span></div>
        <div id="registrants-table" class="registrants-list">
          <% registrants.forEach(registrant => { const checkedIn = Number(registrant.checked_in) > 0; %>
          <article class="registrant-card" data-registrant-id="<%= registrant.id %>" data-registrant-gender="<%= registrant.gender %>" data-registrant-name="<%= registrant.first_name %> <%= registrant.last_name %>" data-registrant-checked-in="<%= checkedIn %>">
            <div class="registrant-identity">
              <span class="registrant-avatar" aria-hidden="true"><%= (registrant.first_name || '?').charAt(0).toUpperCase() %></span>
              <div class="registrant-info"><a href="/admin/<%= registrant.id %>" class="registrant-name"><%= registrant.first_name %> <%= registrant.last_name %> <span aria-hidden="true">↗</span></a><p>Age <%= registrant.age %> <span aria-hidden="true">·</span> Pickup code <strong>#<%= registrant.id %></strong></p></div>
            </div>
            <div class="registrant-actions"><span class="status-pill <%= checkedIn ? 'is-in' : 'is-out' %>" data-status-label><span aria-hidden="true"></span><%= checkedIn ? 'Checked in' : 'Checked out' %></span><button type="button" class="message-action" data-open-sms aria-label="Text parent of <%= registrant.first_name %> <%= registrant.last_name %>" title="Text parent">✉</button><button type="button" class="status-action <%= checkedIn ? 'action-out' : 'action-in' %>" data-status-action aria-label="<%= checkedIn ? 'Check out' : 'Check in' %> <%= registrant.first_name %> <%= registrant.last_name %>"><%= checkedIn ? 'Check out' : 'Check in' %></button><button type="button" class="delete-action" data-delete-action aria-label="Delete <%= registrant.first_name %> <%= registrant.last_name %>" title="Delete registration">×</button></div>
          </article>
          <% }); %>
        </div>
        <div class="empty-state" id="empty-state" <%= registrants.length ? 'hidden' : '' %>><span aria-hidden="true">✿</span><h3>Nothing here just yet</h3><p>Try another search or filter to find your adventurer.</p></div>
      </section>
      <footer class="admin-footer">MADE WITH <span>♥</span> FOR LITTLE ADVENTURES</footer>
    </main>
    <dialog class="sms-drawer" id="sms-drawer" aria-labelledby="sms-drawer-title"><div class="sms-drawer-header"><div><span class="admin-eyebrow">STAFF MESSAGING</span><h2 id="sms-drawer-title">Text a parent</h2><p id="sms-recipient"></p></div><button type="button" id="sms-close" aria-label="Close messaging">×</button></div><p id="sms-drawer-status" role="status"></p><label for="sms-event-assignment">Assign this child to an event</label><div class="sms-assignment"><select id="sms-event-assignment"></select><button type="button" id="sms-assign">Assign</button></div><small>Event assignment does not grant text-message consent.</small><button type="button" id="sms-template" class="sms-template">Use pickup reminder template</button><label for="sms-message">Your message</label><textarea id="sms-message" maxlength="480" rows="5" placeholder="Write a message to the parent…"></textarea><small>Up to 480 characters. Longer messages may cost more.</small><button type="button" id="sms-send" class="status-action action-in">Send text</button><h3>Recent messages</h3><div id="sms-history"></div></dialog>
  </body>
</html>