<%- include("registration-layout") %>
    <script src="/js/hero-parallax.js" defer></script>
    <script>
      // Dropdown displayed so users can choose a specific registrant
      function displayDropdown() {
        const dropdown = document.querySelector(".registrants-dropdown");
        dropdown.style.display = "block";
      }

      // Hide the dropdown for users can choose a specific registrant
      function hideDropdown(e) {
        const dropdown = document.querySelector(".registrants-dropdown");
        dropdown.style.display = "none";
      }

      function handleFocus() {
        const registratnNameInput = document.getElementById("fn");
        if (registratnNameInput.value.length > 0) {
          displayDropdown();
        }
      }

      function handleBlur() {
        setTimeout(() => {
          hideDropdown();
        }, 200);
      }

      function filterRegistrants() {
        const input = document.getElementById("fn");
        const dropdown = document.querySelector(".registrants-dropdown");
        const buttons = Array.from(dropdown.querySelectorAll("button"));

        // only if the dropdown is not showing already, display it
        if (dropdown.style.display !== "block") {
          displayDropdown();
        }

        const nonMatches = [];
        const totalMatches = buttons.filter((button) => {
          const name = button.querySelector("p").getAttribute("data-value");
          const isMatch = name
            .toLowerCase()
            .includes(input.value.toLowerCase());
          if (!isMatch) nonMatches.push(button);
          return isMatch;
        });

        for (let match of totalMatches) {
          match.style.display = "block";
        }

        for (let nonMatch of nonMatches) {
          nonMatch.style.display = "none";
        }

        if (totalMatches.length === 0) {
          hideDropdown();
        }
      }

      // fill out all the inputs with the registrant data
      function chooseRegistrant(registrant) {
        // Fill out the inputs with the registrant data
        document.getElementById("fn").value = registrant.first_name;
        document.getElementById("ln").value = registrant.last_name;
        document.getElementById("gfn").value = registrant.guardian_first_name;
        document.getElementById("gln").value = registrant.guardian_last_name;

        // if they are choosing a child that is already registered
        // update the attendance fields
        const attendance = registrant.attendance || "";
        document.getElementById("attendance").value = attendance.includes("GMC.2025")
          ? attendance
          : [attendance, "GMC.2025"].filter(Boolean).join(", ");

        // if they are choosing a child or guardian that is already registered
        // we need the id to look them up
        document.getElementById("id").value = registrant.id;
        document.getElementById("gid").value = registrant.guardian_id;

        const selectRegistrantAlert = document.querySelector(
          ".select-registrant-alert"
        );

        selectRegistrantAlert.style.display = "block";

        hideDropdown();
      }
    </script>

    <script>
      async function handleRegister(event) {
        const {
          phone_number,
          guardian_id,
          guardian_ln,
          guardian_fn,
          attendance,
          first_name,
          last_name,
          gender,
          age,
          id,
        } = getInputs();

        const canContinue = validateInputs();

        // Create JSON body
        const body = JSON.stringify({
          guardian_phone_number: phone_number,
          sms_consent: document.getElementById("sms-consent").checked,
          guardian_first_name: guardian_fn,
          guardian_last_name: guardian_ln,
          guardian_id,
          attendance,
          checked_in: 0,
          first_name,
          last_name,
          gender,
          age,
          id,
        });

        if (!canContinue) {
          return;
        }

        handleLoadingState(true);

        // Send POST request using fetch
        try {
          const req = await fetch("/new", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body,
          });
          const res = await req.json();

          if (res?.success) {
            const { data } = res;
            const query = new URLSearchParams({ id: data.id, firstName: data.first_name, lastName: data.last_name, sms: data.smsStatus }).toString();

            const router = `/success?${query}`;
            location.href = router;
          } else {
            showToast(res.error || "Something went wrong, please try again!", "error");
            handleLoadingState(false);
          }
        } catch (error) {
          console.error(error);
          showToast("Something went wrong, please try again!", "error");
          handleLoadingState(false);
        }
      }

      // i get the inputs and return them in an abject
      function getInputs() {
        const attendance = document.getElementById("attendance").value;
        const phone_number = document.getElementById("gphone").value;
        const guardian_fn = document.getElementById("gfn").value;
        const guardian_ln = document.getElementById("gln").value;
        const guardian_id = document.getElementById("gid").value;
        const ageString = document.getElementById("age").value;
        const first_name = document.getElementById("fn").value;
        const gender = document.getElementById("gender").value;
        const last_name = document.getElementById("ln").value;
        const id = document.getElementById("id").value;

        const age = Number(ageString || "1");

        return {
          phone_number,
          guardian_ln,
          guardian_fn,
          guardian_id,
          first_name,
          attendance,
          last_name,
          gender,
          age,
          id,
        };
      }

      // I validate the inputs to make sure they are not empty
      // and agree with the required parameters
      function validateInputs() {
        const {
          phone_number,
          guardian_ln,
          guardian_fn,
          first_name,
          last_name,
          gender,
          age,
        } = getInputs();

        // Check if any of the required fields are empty or equal to zero
        if (!first_name || !last_name) {
          showToast("Name and last name of the child are required!", "error");
          return false;
        }

        if (!(age > 3) || !(age < 12)) {
          showToast("Age ranges are 4 - 11", "error");
          return false;
        }

        if (!(gender > 0)) {
          showToast("Please enter the gender", "error");
          return false;
        }

        if (!guardian_fn || !guardian_ln) {
          showToast("Guardian first and last name required", "error");
          return false;
        }

        if (!phone_number) {
          showToast("Guardian phone number is required", "error");
          return false;
        }

        return true;
      }

      // handles styles for selecting the gender btn.
      function handleGender(value, gender) {
        const radioInput = document.getElementById("gender");
        const buttonContainer = document.getElementById(gender);

        const buttonMale = document.querySelector("#malebtn");
        const buttonFemale = document.querySelector("#femalebtn");

        buttonMale.classList.remove("active");
        buttonFemale.classList.remove("active");
        buttonMale.setAttribute("aria-pressed", "false");
        buttonFemale.setAttribute("aria-pressed", "false");

        buttonContainer.classList.add("active");
        buttonContainer.setAttribute("aria-pressed", "true");

        radioInput.value = value;
      }

      // handles the loading state for button
      function handleLoadingState(isLoading) {
        const button = document.querySelector("#register-btn");
        button.innerHTML = isLoading ? "Getting ready..." : '<span>Let’s get registered</span><span class="button-arrow" aria-hidden="true">↗</span>';
        button.disabled = isLoading;
      }
    </script>
  </body>
</html>
